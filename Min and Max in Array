import java.util.*;
import java.util.Queue;
import java.util.PriorityQueue;

public class Main {
    public static void main(String[] args) {
      int [] arr = {14,13,10,7};
      int min = findMin(arr);
      System.out.println(min);
    }

    private static int findMin(int [] arr){
      if(arr == null || arr.length<2) return arr[0];

      Queue<Integer> pq = new PriorityQueue<>(); // by default min heap

      for(int index = 0; index<arr.length; index++){
        pq.offer(arr[index]); // push into the Queue
      }

      return pq.peek(); // return top most element of Queue
    }
}

/*
Approach : Find min Using PriorityQueue at O(1)
TC: O(N)
SC: O(1)

Note: To find max, use PriorityQueue<>(Collections.reverseOrder()); // Max heap
*
